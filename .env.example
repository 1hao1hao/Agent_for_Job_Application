# 只填写本地环境，不要提交真实值。
DEEPSEEK_API_KEY=
DATABASE_URL=postgresql://evalrag:evalrag-local@localhost:5432/evalrag
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=evalrag-local
EVALRAG_LLM_BACKEND=fake
EVALRAG_MODEL=deterministic-demo
EVALRAG_CONTEXT_STRATEGY=source_balanced
EVALRAG_CONTEXT_MODE=adaptive
# 可选：存在固定 BGE 索引时，Memory Query 使用同模型编码并走 pgvector top-k。
EVALRAG_MEMORY_INDEX_DIR=data/processed/indexes/evalrag_v0.3/bge-small-zh-v1.5
QUERY_TIMEOUT_SECONDS=90
EVALUATION_TIMEOUT_SECONDS=1800
